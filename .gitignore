# Generated by Cargo — compiled files and executables
/target/
# NOTE: Cargo.lock is intentionally tracked (binary crate).
# See https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these (debugging information)
*.pdb

# RustRover / IntelliJ
.idea/

# VS Code
.vscode/

# Vim / Emacs swap and backup files
*.swp
*.swo
*~
*.orig

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride

# Linux trash / thumbnails
.Trash-*
*~

# Environment / secrets — never commit real credentials
.env
.env.*
!.env.example

# Local user config (example file is tracked as config.example.toml)
config.toml
**/config.toml
proofd*.log
*.log

# Profiling / coverage / benchmarks
*.profraw
*.profdata
lcov.info
coverage/
criterion/
