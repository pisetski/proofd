<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.proofd</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Edit this path to your install location (commonly ~/.cargo/bin/proofd). -->
    <string>/Users/YOU/.cargo/bin/proofd</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- LaunchAgents get a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin), so
       Homebrew (~/.cargo/bin, ~/.local/bin, /opt/homebrew/bin) CLIs are
       invisible. Either set provider_bin in config.toml (preferred) or
       uncomment the PATH below. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/YOU/.cargo/bin:/Users/YOU/.local/bin:/Users/YOU/.opencode/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/proofd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/proofd.err.log</string>
</dict>
</plist>
